# Copy this file to backend/.env (which git ignores) and fill in what you need.
# The backend reads backend/.env when it starts. Never commit the real file.

# Your Anthropic API key. Leave it out to run the AI chat in demo mode (a scripted stand-in, no cost).
ANTHROPIC_API_KEY=your-key-here

# Optional. Which Claude model answers the chat. The default is claude-opus-5-5.
# Cheaper options to try after testing quality with Bangla and Banglish: claude-sonnet-5-5, claude-haiku-5-5.
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional. How hard the model thinks: low (fastest, cheapest), medium or high. Default: low.
ANTHROPIC_EFFORT=low

# Optional. Set to true to let people create accounts. Default: false (signup closed).
ALLOW_REGISTRATION=false
